{
  "name": "nechto",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @nechto/web",
    "dev:api": "npm run dev -w @nechto/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:api && npm run test:api:e2e && npm run test:e2e",
    "test:api": "npm run test -w @nechto/api",
    "test:api:e2e": "npm run test:e2e -w @nechto/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "npm run prisma:generate -w @nechto/api",
    "db:migrate": "npm run prisma:migrate -w @nechto/api",
    "db:deploy": "npm run prisma:deploy -w @nechto/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0"
  }
}
