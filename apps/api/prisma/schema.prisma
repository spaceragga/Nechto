generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  authVersion         Int                  @default(0)
  isCurator           Boolean              @default(false)
  isModerator         Boolean              @default(false)
  isAdmin             Boolean              @default(false)
  suspendedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  passwordResetTokens PasswordResetToken[]
  dialogues           Dialogue[]
  reports             Report[]
  comments            Comment[]
  moderationActions   ModerationAction[]
  notifications       Notification[]       @relation("NotificationRecipient")
  actedNotifications  Notification[]       @relation("NotificationActor")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /** work_* | profile_followed | project_* | article_* | dialogue_* */
  kind       String
  actorId    String?
  actor      User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workId     String?
  projectId  String?
  articleId  String?
  dialogueId String?
  profileId  String?
  commentId  String?
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([commentId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  bio            String?
  avatarKey      String?
  slug           String?   @unique
  directions     String[]  @default([])
  websiteUrl     String?
  instagramUrl   String?
  telegramUrl    String?
  acceptPolicies Boolean   @default(false)
  publishedAt    DateTime?
  /** Moderator hide: keeps publishedAt, removes from public feeds. */
  hidden         Boolean   @default(false)
  studioTitle       String?
  studioDescription String?  @db.Text
  studioCoverKey    String?
  studioListedAt DateTime?
  studioFeaturedAt DateTime?
  studioHidden   Boolean   @default(false)
  homeFeaturedAt DateTime?
  homeSelectionAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  works          Work[]
  projects       Project[]
  articles       Article[]
  reports        Report[]

  @@index([publishedAt])
  @@index([hidden])
  @@index([studioListedAt])
  @@index([studioFeaturedAt])
  @@index([homeFeaturedAt])
  @@index([homeSelectionAt])
}

model Work {
  id            String         @id @default(cuid())
  profileId     String
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String         @default("")
  imageKey      String
  hidden        Boolean        @default(false)
  featuredAt    DateTime?
  hangingAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectBlocks ProjectBlock[]
  articleCovers Article[]
  dialoguesLeft Dialogue[]     @relation("DialogueLeft")
  dialoguesRight Dialogue[]    @relation("DialogueRight")
  comments      Comment[]

  @@index([profileId, createdAt])
  @@index([createdAt])
  @@index([featuredAt])
  @@index([hangingAt])
}

model Article {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  lede        String    @default("")
  body        String
  coverWorkId String?
  coverWork   Work?     @relation(fields: [coverWorkId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  featuredAt  DateTime?
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([profileId, createdAt])
  @@index([publishedAt])
  @@index([featuredAt])
}

model Dialogue {
  id              String    @id @default(cuid())
  title           String
  note            String    @default("")
  leftWorkId      String
  rightWorkId     String
  leftWork        Work      @relation("DialogueLeft", fields: [leftWorkId], references: [id], onDelete: Restrict)
  rightWork       Work      @relation("DialogueRight", fields: [rightWorkId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  featuredAt      DateTime?
  hidden          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]

  @@index([publishedAt])
  @@index([featuredAt])
  @@index([createdByUserId])
}

model Project {
  id          String         @id @default(cuid())
  profileId   String
  profile     Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String         @default("")
  hidden      Boolean        @default(false)
  featuredAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  blocks      ProjectBlock[]
  comments    Comment[]

  @@index([profileId, createdAt])
  @@index([hidden])
  @@index([featuredAt])
}

model ProjectBlock {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  kind      String
  workId    String?
  work      Work?   @relation(fields: [workId], references: [id], onDelete: Restrict)
  body      String  @default("")
  showTitle Boolean @default(true)

  @@unique([projectId, position])
  @@index([workId])
}

model Report {
  id          String    @id @default(cuid())
  /** profile | work | project | article | dialogue */
  targetType  String
  targetId    String
  targetTitle String    @default("")
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reporterId  String?
  reporter    User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reason      String
  details     String    @default("")
  email       String
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([profileId])
  @@index([reporterId])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  /** hide_work | unhide_work | hide_project | … | resolve_report */
  action     String
  targetType String
  targetId   String
  reportId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

model Comment {
  id         String    @id @default(cuid())
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String    @db.Text
  workId     String?
  work       Work?     @relation(fields: [workId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  articleId  String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  dialogueId String?
  dialogue   Dialogue? @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  notifications Notification[]

  @@index([workId, createdAt])
  @@index([projectId, createdAt])
  @@index([articleId, createdAt])
  @@index([dialogueId, createdAt])
  @@index([authorId, createdAt])
}
