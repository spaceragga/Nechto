generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  authVersion         Int                  @default(0)
  isCurator           Boolean              @default(false)
  isModerator         Boolean              @default(false)
  isAdmin             Boolean              @default(false)
  suspendedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  profile             Profile?
  passwordResetTokens PasswordResetToken[]
  dialogues           Dialogue[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  bio            String?
  avatarKey      String?
  slug           String?   @unique
  directions     String[]  @default([])
  websiteUrl     String?
  instagramUrl   String?
  telegramUrl    String?
  acceptPolicies Boolean   @default(false)
  publishedAt    DateTime?
  studioTitle       String?
  studioDescription String?  @db.Text
  studioCoverKey    String?
  studioListedAt DateTime?
  studioFeaturedAt DateTime?
  studioHidden   Boolean   @default(false)
  homeFeaturedAt DateTime?
  homeSelectionAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  works          Work[]
  projects       Project[]
  articles       Article[]

  @@index([publishedAt])
  @@index([studioListedAt])
  @@index([studioFeaturedAt])
  @@index([homeFeaturedAt])
  @@index([homeSelectionAt])
}

model Work {
  id            String         @id @default(cuid())
  profileId     String
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  description   String         @default("")
  imageKey      String
  hidden        Boolean        @default(false)
  featuredAt    DateTime?
  hangingAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectBlocks ProjectBlock[]
  articleCovers Article[]
  dialoguesLeft Dialogue[]     @relation("DialogueLeft")
  dialoguesRight Dialogue[]    @relation("DialogueRight")

  @@index([profileId, createdAt])
  @@index([createdAt])
  @@index([featuredAt])
  @@index([hangingAt])
}

model Article {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  lede        String    @default("")
  body        String
  coverWorkId String?
  coverWork   Work?     @relation(fields: [coverWorkId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  featuredAt  DateTime?
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId, createdAt])
  @@index([publishedAt])
  @@index([featuredAt])
}

model Dialogue {
  id              String    @id @default(cuid())
  title           String
  note            String    @default("")
  leftWorkId      String
  rightWorkId     String
  leftWork        Work      @relation("DialogueLeft", fields: [leftWorkId], references: [id], onDelete: Restrict)
  rightWork       Work      @relation("DialogueRight", fields: [rightWorkId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  featuredAt      DateTime?
  hidden          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishedAt])
  @@index([featuredAt])
  @@index([createdByUserId])
}

model Project {
  id          String         @id @default(cuid())
  profileId   String
  profile     Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String         @default("")
  featuredAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  blocks      ProjectBlock[]

  @@index([profileId, createdAt])
  @@index([featuredAt])
}

model ProjectBlock {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  kind      String
  workId    String?
  work      Work?   @relation(fields: [workId], references: [id], onDelete: Restrict)
  body      String  @default("")
  showTitle Boolean @default(true)

  @@unique([projectId, position])
  @@index([workId])
}
