FROM node:22-alpine AS builder
WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/api-contract/package.json packages/api-contract/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN npm ci --ignore-scripts
COPY packages packages
COPY apps/api apps/api
RUN npm run build:packages && npm run build -w @nechto/api

FROM node:22-alpine AS runner
ENV NODE_ENV=production
WORKDIR /workspace
RUN addgroup -S nechto && adduser -S nechto -G nechto
COPY --from=builder --chown=nechto:nechto /workspace/node_modules node_modules
COPY --from=builder --chown=nechto:nechto /workspace/apps/api/dist apps/api/dist
COPY --from=builder --chown=nechto:nechto /workspace/apps/api/prisma apps/api/prisma
COPY --from=builder --chown=nechto:nechto /workspace/apps/api/package.json apps/api/package.json
RUN mkdir -p /workspace/apps/api/uploads && chown nechto:nechto /workspace/apps/api/uploads
USER nechto
WORKDIR /workspace/apps/api
EXPOSE 3001
CMD ["node", "dist/main.js"]
