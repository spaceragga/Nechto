POSTGRES_USER=nechto
POSTGRES_PASSWORD=nechto
POSTGRES_DB=nechto
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=3000

# Local processes (Nest/Prisma CLI on the host) use localhost.
DATABASE_URL=postgresql://nechto:nechto@localhost:5432/nechto

# Host-local RSC / Next proxy → API. Docker Compose overrides this to http://api:3001.
API_INTERNAL_URL=http://localhost:3001

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Storage (local disk)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
WEB_PUBLIC_URL=http://localhost:3000
# Use "json" locally and "smtp" in production.
MAIL_TRANSPORT=json
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Nechto <hello@nechto.by>
PASSWORD_RESET_TTL_MINUTES=30

# Optional comma-separated CORS origins. Empty/omit allows all in development.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
