POSTGRES_USER=nechto
POSTGRES_PASSWORD=nechto
POSTGRES_DB=nechto
POSTGRES_PORT=5432

API_PORT=3001
WEB_PORT=3000

# Local processes (Nest/Prisma CLI on the host) use localhost.
DATABASE_URL=postgresql://nechto:nechto@localhost:5432/nechto

# Browser-facing API URL for Next.js (client components)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server Components / Docker: web container → api service (defaults to NEXT_PUBLIC_API_URL)
# API_INTERNAL_URL=http://api:3001

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Storage (local disk now; S3-compatible driver later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/uploads

# Optional comma-separated CORS origins. Empty/omit allows all in development.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
